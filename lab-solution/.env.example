# ==========================================
# Application Log Analyzer MCP Configuration
# ==========================================

# Google Gemini API Key for Chatbot CLI (Bài 1)
# Lấy API key miễn phí tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Secret Bearer Token for MCP Authentication (Bài 2 & Bài 3)
MCP_AUTH_TOKEN=log-reader-secret-token-2026
ADMIN_AUTH_TOKEN=admin-super-secret-9999

# MCP Server Network Configuration (Streamable HTTP)
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000

# Log File Path configuration
LOG_FILE_PATH=data/app.log
